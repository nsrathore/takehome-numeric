// This is your Prisma schema file.
// Swap `provider = "sqlite"` for "postgresql" and update DATABASE_URL if you
// need real concurrency / JSON columns / etc. Everything else stays the same.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Singleton — one active game, no auth/multi-tenancy in scope.
model GameState {
  id         String  @id @default(cuid())
  cash       Float
  currentDay Int     @default(1)

  iceStock    Float @default(0)
  lemonsStock Float @default(0)
  sugarStock  Float @default(0)
  cupsStock   Int   @default(0)

  // Running weighted-average unit cost per ingredient, needed for COGS.
  avgIceCost    Float @default(0)
  avgLemonCost  Float @default(0)
  avgSugarCost  Float @default(0)
  avgCupCost    Float @default(0)

  isGameOver Boolean @default(false)
  isBankrupt Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Per-day history record, written once per simulated day.
model Day {
  id        String  @id @default(cuid())
  dayNumber Int
  price     Float
  weather   String?

  // Number of people who wanted lemonade that day. Recipe is 1 cup per
  // person, so this is also "number of people" -- there is deliberately no
  // separate field for that; don't add one.
  unitsDemanded    Int
  unitsSold        Int
  endedEarly       Boolean @default(false) // true when inventory ran out before demand was met (sold out)
  peopleTurnedAway Int     @default(0) // unitsDemanded - unitsSold, i.e. people who wanted a cup but couldn't get one

  revenue Float
  cogs    Float
  profit  Float

  cashAtStart Float
  cashAtEnd   Float

  isVarianceDay       Boolean @default(false)
  varianceZScore      Float?
  varianceExplanation String? // JSON.stringify'd array of bullet strings; JSON.parse client-side (not Prisma's Json type, to stay consistent with the rest of this schema)

  createdAt DateTime @default(now())
}

// Per-purchase log — makes weighted-average cost-basis (COGS) possible.
model Purchase {
  id         String @id @default(cuid())
  dayNumber  Int
  ingredient String // "ice" | "cups" | "lemons" | "sugar"
  quantity   Float
  unitCost   Float // actual discounted price paid
  totalCost  Float

  createdAt DateTime @default(now())
}
